{
  "name": "vitepress-allyouneed",
  "version": "0.2.0-beta.0",
  "description": "Vitepress extention made for wikilinks, image embeds, note transclusion, frontmatter aliases, auto assets, systematic vault index, plus v0.2 auto-generated views (VaultGraph/VaultStats/Tags). Forked from actuallysomecat/markdown-it-wikilinks-plus.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vitepress": {
      "types": "./dist/vitepress.d.ts",
      "import": "./dist/vitepress.js",
      "require": "./dist/vitepress.cjs"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "require": "./dist/vite.cjs"
    },
    "./markdown-it": {
      "types": "./dist/markdown-it.d.ts",
      "import": "./dist/markdown-it.js",
      "require": "./dist/markdown-it.cjs"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js",
      "require": "./dist/theme/index.cjs"
    },
    "./theme/components/*.vue": "./dist/theme/components/*.vue",
    "./theme/styles/*.css": "./dist/theme/styles/*.css",
    "./theme/style.css": "./dist/theme/styles/index.css",
    "./style.css": "./style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "style.css",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && node scripts/write-theme-dts.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist coverage"
  },
  "keywords": [
    "vitepress",
    "vitepress-plugin",
    "markdown-it",
    "markdown-it-plugin",
    "obsidian",
    "notion",
    "wikilinks",
    "wikilink",
    "transclusion",
    "embed",
    "vault",
    "graph",
    "tags"
  ],
  "license": "MIT",
  "author": "tangxiaoyi97 <tangxy97@hotmail.com>",
  "homepage": "https://github.com/tangxiaoyi97/vitepress-allyouneed",
  "bugs": "https://github.com/tangxiaoyi97/vitepress-allyouneed/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tangxiaoyi97/vitepress-allyouneed.git"
  },
  "peerDependencies": {
    "markdown-it": "^14.0.0",
    "vitepress": "^1.0.0",
    "vite": "^5.0.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "vitepress": { "optional": true },
    "vite": { "optional": true }
  },
  "dependencies": {
    "@mdit-vue/shared": "^2.1.3",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "gray-matter": "^4.0.3",
    "picomatch": "^4.0.2"
  },
  "devDependencies": {
    "@types/d3-drag": "^3.0.7",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.5",
    "@types/picomatch": "^3.0.2",
    "markdown-it": "^14.1.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitepress": "^1.6.3",
    "vitest": "^2.1.8",
    "vue": "^3.5.13"
  },
  "engines": {
    "node": ">=18"
  }
}
