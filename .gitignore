# ─ Node / npm ───────────────────────────────────────────────────
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm
.pnpm-store
.yarn

# ─ 构建产物(npm publish 走 `files` 白名单,这里只是不入 git)──
dist
coverage
*.tsbuildinfo
.tsup
# tsup / vite 加载 TS 配置时落的临时 bundle(进程退出有时来不及清,忽略掉)
tsup.config.bundled_*.mjs
vitest.config.ts.timestamp-*.mjs
*.config.ts.timestamp-*.mjs

# ─ VitePress(根目录 + 任意子目录,如 examples/.vitepress)──
.vitepress/cache
.vitepress/dist
**/.vitepress/cache
**/.vitepress/dist

# ─ 示例站插件自动生成的产物(每次 build 由插件重写,不入库避免 diff 噪音)──
# 注:若这些已被跟踪,需 `git rm --cached` 一次才真正生效
examples/*/public/vault-data.json
examples/*/_perspectives_/

# ─ 一次性迁移脚本 / 临时验证残留(不入库)──
examples/*/MIGRATE-i18n.sh
examples/*/__test.txt
**/__test.txt

# ─ 环境 / 密钥 ──────────────────────────────────────────────────
.env
.env.*
!.env.example

# ─ 编辑器 / IDE ─────────────────────────────────────────────────
.idea
.vscode
.history
*.swp
*.swo
*~

# ─ OS 杂物 ──────────────────────────────────────────────────────
.DS_Store
._.DS_Store
Thumbs.db
desktop.ini

# ─ 日志 ────────────────────────────────────────────────────────
*.log

# ─ 沙箱 / 临时验证脚本(沙箱里我留的,你本地手动 rm 了就不会重生)──
.test-*.mjs
.validate*.mjs
.smoke.mjs

# ─ 本地维护文档(只给作者自己看的 cheat-sheet,不入库)──
PUBLISHING.md
REVIEW-*.md